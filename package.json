{
  "name": "certificate-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib tests proxy.ts next.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "tsx --test tests/admin-auth.test.ts tests/storage.test.ts tests/email-template.test.ts tests/issuer.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.21.1",
    "csv-parse": "7.0.3",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "5.21.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
