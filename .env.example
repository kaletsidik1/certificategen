# Database connection. Use a separate staging database for local tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Canonical public URL used by certificate QR codes and email verification links.
APP_URL="http://127.0.0.1:3000"

# Admin Basic Auth credentials. Set both to strong unique values before production.
ADMIN_USERNAME="certificate-admin"
ADMIN_PASSWORD="replace-with-a-long-random-secret"

# One issuer per deployment. Public display values are safe to show on verification pages.
ISSUER_NAME="Example Organization"
ISSUER_WEBSITE_URL="https://example.org"
ISSUER_LINKEDIN_URL=""
ISSUER_SUPPORT_EMAIL="certificates@example.org"
ISSUER_LOCALE="en-US"
CERTIFICATE_NUMBER_PREFIX="CERT"
DEFAULT_EMAIL_SUBJECT="Your certificate from {issuer}"
DEFAULT_EMAIL_MESSAGE="Congratulations on completing your program with {issuer}! Thank you for your patience while we prepared your certificate. We appreciate your time with us and wish you continued success."

# Local filesystem storage. Production deployments need a persistent mounted volume.
CERTIFICATE_STORAGE_DIR="./certificate-store"

# SMTP mail transport. Do not commit actual credentials.
SMTP_HOST="smtp.example.org"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="replace-with-smtp-secret"
EMAIL_FROM="Certificates <certificates@example.org>"
